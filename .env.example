# PocketBase is opt-in. Leave unset to play in local mode (no console errors,
# rooms stay in this browser). Set it — or use "Use a shared PocketBase
# server" on the landing page — to enable multiplayer via PocketBase.
# VITE_PB_URL=http://127.0.0.1:8090

# --- Cloudflare + Neon via Alchemy (deploy) ---
# Jangan export manual. Auth disimpan di profile Alchemy:
#   pnpm alchemy profile edit --add Cloudflare   (OAuth browser / API token)
#   pnpm alchemy profile edit --add Neon         (NEON_API_KEY)
# Lalu: pnpm deploy:dry  ->  pnpm deploy
